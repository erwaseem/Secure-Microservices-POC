{
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "System": "Warning"
            }
        },
        "WriteTo": [
            { "Name": "Console" },
            {
                "Name": "File",
                "Args": {
                    "path": "Logs/product-service-.log",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 30,
                    "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
                }
            }
        ]
    },

    "AllowedHosts": "*",
    "ConnectionStrings": {
        "ProductDb": "Server=.;Database=SecureProductDb;Trusted_Connection=True;TrustServerCertificate=True"
    },
    "RabbitMQ": {
        "Host": "localhost",
        "VHost": "/",
        "Username": "guest",
        "Password": "guest"
    },
    "Jwt": {
        "Issuer": "SecureMicroservices.POC",
        "Audience": "SecureMicroservices.POC.Client",
        "Key": "THIS_IS_DEMO_SECRET_CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
    },
    "Urls": "http://localhost:5138"
}
