{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Yarp": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/api-gateway-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Jwt": {
    "Issuer": "SecureMicroservices.POC",
    "Audience": "SecureMicroservices.POC.Client",
    "Key": "THIS_IS_DEMO_SECRET_CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/auth/{**catch-all}" }
      },
      "products-route": {
        "ClusterId": "products-cluster",
        "Match": { "Path": "/api/Products/{**catch-all}" }
      },
      "cart-route": {
        "ClusterId": "cart-cluster",
        "Match": { "Path": "/api/Cart/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": { "d1": { "Address": "http://localhost:5001" } }
      },
      "products-cluster": {
        "Destinations": { "d1": { "Address": "http://localhost:5138" } }
      },
      "cart-cluster": {
        "Destinations": { "d1": { "Address": "http://localhost:5164" } }
      }
    }
  },
  "Kestrel": { "Endpoints": { "Http": { "Url": "http://localhost:5020" } } },
  "AllowedHosts": "*"
}
